<section class="item-body">

  {{#if (laundryEq item.type "talent")}}
  <div class="field-grid">
    <div class="form-group">
      <label>Type</label>
      <select name="system.talentType">
        {{#each talentTypes as |label key|}}
        <option value="{{key}}" {{#if (laundryEq ../system.talentType key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group"><label>Adrenaline Cost</label><input type="number" name="system.adrenalineCost" value="{{system.adrenalineCost}}" min="0"></div>
    <div class="form-group span2"><label>Requirements</label><input type="text" name="system.requirements" value="{{system.requirements}}"></div>
  </div>
  {{/if}}

  {{#if (laundryEq item.type "weapon")}}
  <div class="field-grid">
    <div class="form-group">
      <label>Attack Type</label>
      <select name="system.attackType">
        {{#each attackTypes as |label key|}}
        <option value="{{key}}" {{#if (laundryEq ../system.attackType key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Skill</label>
      <select name="system.skill">
        {{#each skillChoices as |label key|}}
        <option value="{{key}}" {{#if (laundryEq ../system.skill key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group"><label>Pool</label><input type="number" name="system.pool" value="{{system.pool}}" min="0"></div>
    <div class="form-group"><label>Focus</label><input type="number" name="system.focus" value="{{system.focus}}" min="0"></div>
    <div class="form-group"><label>Damage</label><input type="text" name="system.damage" value="{{system.damage}}"></div>
    <div class="form-group"><label>Range</label><input type="text" name="system.range" value="{{system.range}}"></div>
    <div class="form-group span2"><label>Traits</label><input type="text" name="system.traits" value="{{system.traits}}"></div>
    <div class="form-group check"><label>Equipped</label><input type="checkbox" name="system.equipped" {{checked system.equipped}}></div>
  </div>
  {{/if}}

  {{#if (laundryEq item.type "equipment")}}
  <div class="field-grid">
    <div class="form-group"><label>Quantity</label><input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></div>
    <div class="form-group"><label>Location</label><input type="text" name="system.location" value="{{system.location}}"></div>
    <div class="form-group check"><label>Carried</label><input type="checkbox" name="system.carried" {{checked system.carried}}></div>
  </div>
  {{/if}}

  {{#if (laundryEq item.type "spell")}}
  <div class="field-grid">
    <div class="form-group">
      <label>Casting Skill</label>
      <select name="system.skill">
        {{#each skillChoices as |label key|}}
        <option value="{{key}}" {{#if (laundryEq ../system.skill key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group"><label>DN (DN:Complexity)</label><input type="text" name="system.dn" value="{{system.dn}}" placeholder="4:1"></div>
    <div class="form-group"><label>Target</label><input type="text" name="system.target" value="{{system.target}}"></div>
    <div class="form-group"><label>Range</label><input type="text" name="system.range" value="{{system.range}}"></div>
    <div class="form-group span2"><label>Duration</label><input type="text" name="system.duration" value="{{system.duration}}"></div>
  </div>
  <div class="form-group full"><label>Effect</label><div class="editor-box">{{> laundry.editor name="system.effect" value=system.effect enriched=enrichedEffect}}</div></div>
  {{/if}}

  {{#if (laundryEq item.type "itgear")}}
  <div class="field-grid">
    <div class="form-group"><label>Ward Level</label><input type="number" name="system.level" value="{{system.level}}" min="0"></div>
    <div class="form-group"><label>DN (DN:Complexity)</label><input type="text" name="system.dn" value="{{system.dn}}" placeholder="4:1"></div>
    <div class="form-group"><label>Charges</label><input type="number" name="system.charges.value" value="{{system.charges.value}}" min="0"></div>
    <div class="form-group"><label>Max Charges</label><input type="number" name="system.charges.max" value="{{system.charges.max}}" min="0"></div>
    <div class="form-group"><label>Target</label><input type="text" name="system.target" value="{{system.target}}"></div>
    <div class="form-group"><label>Range</label><input type="text" name="system.range" value="{{system.range}}"></div>
    <div class="form-group span2"><label>Duration</label><input type="text" name="system.duration" value="{{system.duration}}"></div>
  </div>
  <div class="form-group full"><label>Effect</label><div class="editor-box">{{> laundry.editor name="system.effect" value=system.effect enriched=enrichedEffect}}</div></div>
  {{/if}}

  <div class="form-group full"><label>Description</label><div class="editor-box">{{> laundry.editor name="system.description" value=system.description enriched=enrichedDescription}}</div></div>
</section>
