<header class="item-header">
  <img class="item-img" src="{{item.img}}" data-action="editImage" data-edit="img" alt="{{item.name}}" data-tooltip="Change image">
  <div class="item-title">
    <input type="text" class="item-name" name="name" value="{{item.name}}" placeholder="Name">
    <span class="item-type-badge">{{localize typeLabel}}</span>
  </div>
</header>
