<section class="laundry-tabpage file {{tabs.file.cssClass}}" data-group="primary" data-tab="file">

  {{!-- Row 1: photo + personal history + possessions --}}
  <div class="file-row file-row-top">
    <div class="file-col photo-col">
      <div class="polaroid">
        <div class="tape"></div>
        <img class="portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="Portrait" data-tooltip="Change portrait">
      </div>
      <div class="panel">
        <div class="panel-head">Next of Kin</div>
        <div class="panel-body editor-box small">{{editor enriched.nextOfKin target="system.bio.nextOfKin" button=true editable=editable engine="prosemirror"}}</div>
      </div>
    </div>

    <div class="panel grow">
      <div class="panel-head">Personal History</div>
      <div class="panel-body editor-box">{{editor enriched.personalHistory target="system.bio.personalHistory" button=true editable=editable engine="prosemirror"}}</div>
    </div>

    <div class="panel grow">
      <div class="panel-head">Possessions &amp; Equipment <a class="add-btn" data-action="createItem" data-type="equipment" data-tooltip="Add Equipment"><i class="fa-solid fa-plus"></i></a></div>
      <div class="panel-body">
        <div class="editor-box short">{{editor enriched.possessions target="system.bio.possessions" button=true editable=editable engine="prosemirror"}}</div>
        <ul class="entry-list">
          {{#each equipment as |e|}}
          <li class="entry" data-item-id="{{e.id}}">
            <img class="entry-img" src="{{e.img}}" alt="">
            <span class="entry-name" data-action="editItem">{{e.name}}{{#if e.system.quantity}} <span class="qty">&times;{{e.system.quantity}}</span>{{/if}}</span>
            <span class="entry-controls">
              <a data-action="editItem" data-tooltip="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
              <a data-action="deleteItem" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>

  {{!-- Row 2: disciplinary + goals + training --}}
  <div class="file-row file-row-three">
    <div class="panel">
      <div class="panel-head">Disciplinary Record</div>
      <div class="panel-body editor-box">{{editor enriched.disciplinary target="system.bio.disciplinary" button=true editable=editable engine="prosemirror"}}</div>
    </div>
    <div class="panel">
      <div class="panel-head">Short-term / Long-term Goals</div>
      <div class="panel-body goals-split">
        <div class="editor-box">{{editor enriched.shortTerm target="system.goals.shortTerm" button=true editable=editable engine="prosemirror"}}</div>
        <div class="editor-box">{{editor enriched.longTerm target="system.goals.longTerm" button=true editable=editable engine="prosemirror"}}</div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-head">Training &amp; Certification</div>
      <div class="panel-body editor-box">{{editor enriched.training target="system.bio.training" button=true editable=editable engine="prosemirror"}}</div>
    </div>
  </div>

  {{!-- IT Equipment --}}
  <div class="panel">
    <div class="panel-head">IT Equipment <a class="add-btn" data-action="createItem" data-type="itgear" data-tooltip="Add IT Equipment"><i class="fa-solid fa-plus"></i></a></div>
    <div class="panel-body">
      <table class="data-table occult-table">
        <thead><tr><th>Name</th><th>DN</th><th>Target</th><th>Range</th><th>Duration</th><th>Effect</th><th class="ctrl-col"></th></tr></thead>
        <tbody>
          {{#each itgear as |g|}}
          <tr data-item-id="{{g.id}}">
            <td><a class="rollable" data-action="rollItem" data-tooltip="Activate">{{g.name}}</a></td>
            <td class="num">{{g.system.dn}}</td>
            <td>{{g.system.target}}</td>
            <td>{{g.system.range}}</td>
            <td>{{g.system.duration}}</td>
            <td class="effect-cell">{{{g.system.effect}}}</td>
            <td class="row-controls">
              <a data-action="editItem" data-tooltip="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
              <a data-action="deleteItem" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  {{!-- Spells --}}
  <div class="panel">
    <div class="panel-head">Spells <a class="add-btn" data-action="createItem" data-type="spell" data-tooltip="Add Spell"><i class="fa-solid fa-plus"></i></a></div>
    <div class="panel-body">
      <table class="data-table occult-table">
        <thead><tr><th>Name</th><th>DN</th><th>Target</th><th>Range</th><th>Duration</th><th>Effect</th><th class="ctrl-col"></th></tr></thead>
        <tbody>
          {{#each spells as |s|}}
          <tr data-item-id="{{s.id}}">
            <td><a class="rollable" data-action="rollItem" data-tooltip="Cast">{{s.name}}</a></td>
            <td class="num">{{s.system.dn}}</td>
            <td>{{s.system.target}}</td>
            <td>{{s.system.range}}</td>
            <td>{{s.system.duration}}</td>
            <td class="effect-cell">{{{s.system.effect}}}</td>
            <td class="row-controls">
              <a data-action="editItem" data-tooltip="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
              <a data-action="deleteItem" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <footer class="classified-footer">
    This record is classified <strong>PERSONA MATRIX RED</strong>, not for distribution. Falsifying information on this record
    is punishable under the Falsified Records Directive (FRD) delegated regulation (1998/161).
  </footer>
</section>
